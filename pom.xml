<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.github.im2back</groupId>
	<artifactId>aws-integration-lab</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>17</java.version>

		<!-- Configurações do SonarQube Cloud -->
		
		<!-- Identifica o projeto no SonarQube Cloud -->
		<sonar.projectKey>im2back_aws-integration-lab.</sonar.projectKey>
		
		<!-- Identifica a organização -->
		<sonar.organization>im2back</sonar.organization>
		
		<!-- Endereço do SonarQube Cloud -->
		<sonar.host.url>https://sonarcloud.io</sonar.host.url>
		
		<!-- Relatório XML de cobertura gerado pelo JaCoCo -->
		<sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
		
		<!-- Exclui arquivos específicos do cálculo de cobertura no SonarQube -->
		<sonar.coverage.exclusions>
		    **/AwsIntegrationLabApplication.java,
		    **/config/**,
		    **/controller/mapper/**,
		    **/controller/dto/**
		</sonar.coverage.exclusions>

	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
		    <groupId>software.amazon.awssdk</groupId>
		    <artifactId>s3</artifactId>
		</dependency>
		<dependency>
		    <groupId>software.amazon.awssdk</groupId>
		    <artifactId>sts</artifactId>
		</dependency>		

		<!-- Spring Boot + Testcontainers -->
		<dependency>
		    <groupId>org.springframework.boot</groupId>
		    <artifactId>spring-boot-testcontainers</artifactId>
		    <scope>test</scope>
		</dependency>
		
		<!-- Integração Testcontainers + JUnit 5 -->
		<dependency>
		    <groupId>org.testcontainers</groupId>
		    <artifactId>testcontainers-junit-jupiter</artifactId>
		    <scope>test</scope>
		</dependency>
		
		<!-- Testcontainers para LocalStack (AWS) -->
		<dependency>
		    <groupId>org.testcontainers</groupId>
		    <artifactId>testcontainers-localstack</artifactId>
		    <scope>test</scope>
		</dependency>
		
	</dependencies>

	<dependencyManagement>
	    <dependencies>
	        <dependency>
	            <groupId>software.amazon.awssdk</groupId>
	            <artifactId>bom</artifactId>
	            <version>2.42.8</version>
	            <type>pom</type>
	            <scope>import</scope>
	        </dependency>
	    </dependencies>
	</dependencyManagement>

	<build>
	    <plugins>

	        <!-- Plugin responsável pelo empacotamento do Spring Boot -->
	        <plugin>
	            <groupId>org.springframework.boot</groupId>
	            <artifactId>spring-boot-maven-plugin</artifactId>
	        </plugin>
	
	        <!-- Plugin responsável pela cobertura de testes -->
	        <plugin>
	            <groupId>org.jacoco</groupId>
	            <artifactId>jacoco-maven-plugin</artifactId>
	            <version>0.8.16</version>
				 <!-- Classes e pacotes que não entrarão no relatório de cobertura -->
			    <configuration>
			        <excludes>
			            <!-- Exclui todos os Mappers -->
			            <exclude>**/controller/mapper/**</exclude>
			
			            <!-- Exclui todos os DTOs -->
			            <exclude>**/controller/dto/**</exclude>
			
			            <!-- Exclui somente a classe principal do Spring Boot -->
			            
			            <exclude>**/AwsIntegrationLabApplication.class</exclude>
			            <!-- Exclui a classe de configuração do S3 -->
						<exclude>**/S3Config.class</exclude>
			        </excludes>
			    </configuration>

	            <executions>
	
	                <!-- Prepara o agente de cobertura antes dos testes -->
	                <execution>
	                    <id>prepare-agent</id>
	                    <goals>
	                        <goal>prepare-agent</goal>
	                    </goals>
	                </execution>
	
	                <!-- Gera os relatórios após a execução dos testes -->
	                <execution>
	                    <id>generate-report</id>
	                    <phase>verify</phase>
	                    <goals>
	                        <goal>report</goal>
	                    </goals>
	                </execution>
					<!-- STEP 3 - Verifica se a cobertura geral atingiu pelo menos 80% -->
					<execution>
					    <id>check-coverage</id>
					
					    <!-- Executa a verificação na fase verify do Maven -->
					    <phase>verify</phase>
					
					    <goals>
					        <goal>check</goal>
					    </goals>
					
					    <configuration>
					        <rules>
					            <rule>
					                <!-- Avalia a cobertura do projeto como um todo -->
					                <element>BUNDLE</element>
					
					                <limits>
					                    <limit>
					                        <!-- Mede a cobertura de linhas -->
					                        <counter>LINE</counter>
					
					                        <!-- Considera a proporção de linhas cobertas -->
					                        <value>COVEREDRATIO</value>
					
					                        <!-- Exige no mínimo 80% -->
					                        <minimum>0.80</minimum>
					                    </limit>
					                </limits>
					            </rule>
					        </rules>
					    </configuration>
					</execution>	
	            </executions>
	        </plugin>
	
	    </plugins>
	</build>

</project>
